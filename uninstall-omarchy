#!/usr/bin/env bash

set -euo pipefail

plugin_id="nwarwick.omambience"
plugin_dir="${HOME}/.config/omarchy/plugins/${plugin_id}"

if [[ -x $plugin_dir/bin/omambience-stop-all ]]; then
  "$plugin_dir/bin/omambience-stop-all" || true
fi

if omarchy plugin list --json | jq -e --arg id "$plugin_id" 'any(.[]; .id == $id)' >/dev/null; then
  omarchy plugin remove "$plugin_id" --yes
else
  printf 'Omambience is not installed.\n'
fi

printf 'Custom audio and saved volumes were left in:\n'
printf '  %s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/omambience"
printf '  %s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/omambience"
