#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/omambience.sh
source "$script_dir/../lib/omambience.sh"

[[ -d $omambience_state_dir ]] || exit 0

shopt -s nullglob
pid_files=("$omambience_state_dir"/*.pid)
shopt -u nullglob

for pid_file in "${pid_files[@]}"; do
  sound="${pid_file##*/}"
  sound="${sound%.pid}"
  omambience_validate_sound "$sound" || continue

  lock_file="$(omambience_lock_file "$sound")"
  exec {lock_fd}>"$lock_file"
  flock "$lock_fd"
  omambience_stop_sound "$sound"
  flock -u "$lock_fd"
  exec {lock_fd}>&-
done
