#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/omambience.sh
source "$script_dir/../lib/omambience.sh"

sound="${1:-}"
change="${2:-}"
if [[ -z $sound || -z $change ]]; then
  echo "Usage: ${0##*/} <sound> <value|+N|-N>" >&2
  exit 2
fi
omambience_require_sound "$sound"
if [[ ! $change =~ ^[+-]?[0-9]{1,3}$ ]]; then
  printf 'Volume must be an integer from -999 to 999, got: %s\n' "$change" >&2
  exit 2
fi

omambience_prepare_state
lock_file="$(omambience_lock_file "$sound")"
exec 9>"$lock_file"
flock 9

current="$(omambience_read_volume "$sound")"
case "$change" in
  +*) target=$((current + 10#${change#+})) ;;
  -*) target=$((current - 10#${change#-})) ;;
  *) target=$((10#$change)) ;;
esac
((target < 0)) && target=0
((target > omambience_max_volume)) && target=$omambience_max_volume

volume_file="$(omambience_volume_file "$sound")"
printf '%s\n' "$target" >"$volume_file.tmp"
mv -f -- "$volume_file.tmp" "$volume_file"

socket="$(omambience_socket_file "$sound")"
if omambience_running_pid "$sound" >/dev/null && [[ -S $socket ]]; then
  printf '{"command":["set_property","volume",%d]}\n' "$target" \
    | socat -T 1 - "UNIX-CONNECT:$socket" >/dev/null 2>&1 || true
fi

printf '%s\n' "$target"
