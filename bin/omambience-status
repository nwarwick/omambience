#!/usr/bin/env bash

set -u

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/omambience.sh
source "$script_dir/../lib/omambience.sh"

usage() {
  echo "Usage: ${0##*/} [--watch]" >&2
}

watch=0
case "${1:-}" in
  "") ;;
  --watch) watch=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac

emit_status() {
  local sound volume active=0 available=0
  local sounds_json='[]'
  local -a names=()

  mapfile -t names < <(omambience_sound_names)
  for sound in "${names[@]}"; do
    ((available++))
    volume="$(omambience_read_volume "$sound")"
    if omambience_running_pid "$sound" >/dev/null; then
      ((active++))
      playing=true
    else
      playing=false
    fi
    sounds_json="$(jq -c \
      --arg name "$sound" \
      --argjson playing "$playing" \
      --argjson volume "$volume" \
      '. + [{name: $name, playing: $playing, volume: $volume}]' \
      <<<"$sounds_json")"
  done

  text="♫"
  ((active > 1)) && text="♫ $active"

  jq -cn \
    --arg text "$text" \
    --argjson active "$active" \
    --argjson available "$available" \
    --argjson sounds "$sounds_json" \
    '{text: $text, active: $active, available: $available, sounds: $sounds}'
}

while :; do
  emit_status
  ((watch)) || break
  sleep 1
done
