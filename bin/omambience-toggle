#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/omambience.sh
source "$script_dir/../lib/omambience.sh"

sound="${1:-}"
if [[ -z $sound ]]; then
  echo "Usage: ${0##*/} <sound>" >&2
  exit 2
fi
omambience_require_sound "$sound"

audio_file="$(omambience_audio_file "$sound")" || {
  printf 'No audio file named %s.ogg in %s or %s\n' \
    "$sound" "$omambience_user_audio_dir" "$omambience_bundled_audio_dir" >&2
  exit 1
}

omambience_prepare_state
lock_file="$(omambience_lock_file "$sound")"
exec 9>"$lock_file"
flock 9

if omambience_running_pid "$sound" >/dev/null; then
  omambience_stop_sound "$sound"
  exit 0
fi

socket="$(omambience_socket_file "$sound")"
pid_file="$(omambience_pid_file "$sound")"
volume="$(omambience_read_volume "$sound")"
playback_gain="$(omambience_playback_gain "$sound" "$audio_file")"
rm -f -- "$socket" "$pid_file"

setsid mpv \
  --no-config \
  --no-video \
  --no-terminal \
  --loop-file=inf \
  --volume="$volume" \
  --volume-gain="$playback_gain" \
  --volume-gain-max=24 \
  --input-ipc-server="$socket" \
  -- "$audio_file" 9>&- >/dev/null 2>&1 &
pid=$!
printf '%s\n' "$pid" >"$pid_file"

# Catch an immediate launch failure instead of leaving a convincing stale pid.
sleep 0.05
if ! omambience_pid_owns_socket "$pid" "$socket"; then
  rm -f -- "$pid_file" "$socket"
  printf 'Failed to start %s\n' "$sound" >&2
  exit 1
fi
