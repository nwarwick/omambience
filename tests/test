#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n \
  "$repo_dir"/bin/omambience-* \
  "$repo_dir/lib/omambience.sh" \
  "$repo_dir/tests/test-cli"

jq -e '
  .schemaVersion == 1
  and .id == "nwarwick.omambience"
  and (.kinds | index("bar-widget") != null)
  and .entryPoints.barWidget == "BarWidget.qml"
' "$repo_dir/manifest.json" >/dev/null

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$repo_dir"
fi
if command -v qmllint >/dev/null 2>&1 && [[ -d /usr/share/omarchy/shell ]]; then
  qmllint -I /usr/share/omarchy/shell "$repo_dir/BarWidget.qml" "$repo_dir/Panel.qml"
fi
grep -Fq 'tooltipText: ""' "$repo_dir/BarWidget.qml"
grep -Fq 'useActiveColor: false' "$repo_dir/BarWidget.qml"
grep -Fq 'Math.round(volumeSlider.liveValue) + "%"' "$repo_dir/Panel.qml"
grep -Fq 'readonly property int maximumVolume: 100' "$repo_dir/BarWidget.qml"
grep -Fq 'omarchy plugin add https://github.com/nwarwick/omambience.git --enable' "$repo_dir/README.md"
grep -Fq 'omarchy plugin remove nwarwick.omambience' "$repo_dir/README.md"
if command -v luac >/dev/null 2>&1; then
  luac -p "$repo_dir/snippets/hypr-omambience.lua"
fi

"$repo_dir/tests/test-cli"
printf 'ok - validation\n'
