#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_id="nwarwick.omambience"

fail() {
  printf 'install-omarchy: %s\n' "$*" >&2
  exit 1
}

command -v omarchy >/dev/null 2>&1 || fail "Omarchy is required"
version="$(omarchy version 2>/dev/null || true)"
[[ $version == 4.* ]] || fail "Omarchy Quattro (4.x) is required; found: ${version:-unknown}"

# These are part of the Quattro base install, but asking the package helper for
# them makes the installer safe on trimmed or customized installations too.
omarchy pkg add mpv socat jq

plugin_source="${OMAMBIENCE_PLUGIN_SOURCE:-}"
if [[ -z $plugin_source ]]; then
  plugin_source="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
fi
[[ -n $plugin_source ]] || plugin_source="$repo_dir"

if omarchy plugin list --json | jq -e --arg id "$plugin_id" 'any(.[]; .id == $id)' >/dev/null; then
  printf 'Omambience is already installed; updating it.\n'
  omarchy plugin update "$plugin_id" --yes
  omarchy plugin enable "$plugin_id"
else
  omarchy plugin add "$plugin_source" --enable --yes
fi

printf '\nOmambience is installed and enabled.\n'
printf 'Left-click its bar widget to open the mixer; right-click to stop all sounds.\n'
printf 'For optional hotkeys, copy the contents of:\n  %s/snippets/hypr-omambience.lua\n' "$repo_dir"
